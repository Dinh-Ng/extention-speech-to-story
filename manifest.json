{
  "manifest_version": 3,
  "name": "Đọc truyện Speech",
  "version": "3.8.0",
  "description": "Trích xuất và đọc nội dung truyện từ truyenfull.vision",
  "permissions": [
    "activeTab",
    "scripting",
    "tts",
    "storage"
  ],
  "host_permissions": [
    "https://truyenfull.vision/*",
    "https://*.truyenfull.vision/*",
    "https://truyenfull.today/*",
    "https://*.truyenfull.today/*",
    "https://truyenfull.com/*",
    "https://*.truyenfull.com/*",
    "https://truyenfull.vn/*",
    "https://*.truyenfull.vn/*",
    "https://tangthuvien.net/*",
    "https://*.tangthuvien.net/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://truyenfull.vision/*",
        "https://*.truyenfull.vision/*",
        "https://truyenfull.today/*",
        "https://*.truyenfull.today/*",
        "https://truyenfull.com/*",
        "https://*.truyenfull.com/*",
        "https://truyenfull.vn/*",
        "https://*.truyenfull.vn/*",
        "https://tangthuvien.net/*",
        "https://*.tangthuvien.net/*"
      ],
      "js": ["src/content/content.js"],
      "css": ["assets/styles/content.css"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
